{
 "1": {
  "class_type": "WanVideoModelLoader",
  "inputs": {
   "model": "__CKPT__",
   "base_precision": "bf16",
   "quantization": "fp8_e4m3fn",
   "load_device": "main_device"
  }
 },
 "2": {
  "class_type": "LoadWanVideoT5TextEncoder",
  "inputs": {
   "model_name": "umt5_fp8.safetensors",
   "precision": "bf16"
  }
 },
 "3": {
  "class_type": "WanVideoTextEncode",
  "inputs": {
   "positive_prompt": "__POS__",
   "negative_prompt": "low quality, worst quality, blurry, jittery",
   "t5": [
    "2",
    0
   ],
   "model_to_offload": [
    "1c",
    0
   ],
   "force_offload": true
  }
 },
 "4": {
  "class_type": "WanVideoEmptyEmbeds",
  "inputs": {
   "width": 832,
   "height": 480,
   "num_frames": 33
  }
 },
 "5": {
  "class_type": "WanVideoSampler",
  "inputs": {
   "model": [
    "1c",
    0
   ],
   "image_embeds": [
    "4",
    0
   ],
   "text_embeds": [
    "3",
    0
   ],
   "steps": 14,
   "cfg": 5.0,
   "shift": 7.0,
   "seed": 42,
   "force_offload": true,
   "scheduler": "unipc",
   "riflex_freq_index": 0
  }
 },
 "6": {
  "class_type": "WanVideoVAELoader",
  "inputs": {
   "model_name": "vae_fp8.safetensors",
   "precision": "bf16"
  }
 },
 "7": {
  "class_type": "WanVideoDecode",
  "inputs": {
   "vae": [
    "6",
    0
   ],
   "samples": [
    "5",
    0
   ],
   "enable_vae_tiling": true,
   "tile_x": 256,
   "tile_y": 256,
   "tile_stride_x": 128,
   "tile_stride_y": 128
  }
 },
 "8": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "7",
    0
   ],
   "fps": 24
  }
 },
 "9": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": [
    "8",
    0
   ],
   "filename_prefix": "xiaojiao_wan",
   "format": "mp4"
  }
 },
 "1b": {
  "class_type": "WanVideoBlockSwap",
  "inputs": {
   "blocks_to_swap": 16,
   "offload_img_emb": true,
   "offload_txt_emb": true
  }
 },
 "1c": {
  "class_type": "WanVideoSetBlockSwap",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "block_swap_args": [
    "1b",
    0
   ]
  }
 }
